# ==============================================================================
# DeadlineSnap Configuration Template
# Copy this file to .streamlit/secrets.toml and populate with your credentials.
# ==============================================================================

# Gemini Vision API Configuration
GEMINI_API_KEY = "your-gemini-api-key"
GEMINI_MODEL = "gemini-2.5-flash"

# Email Notification Settings (SMTP - e.g. Gmail App Password)
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = 587
SMTP_USER = "your-email@gmail.com"
SMTP_PASSWORD = "your-16-char-gmail-app-password"

# Telegram Bot Notification Settings
TELEGRAM_BOT_TOKEN = "your-telegram-bot-token"
TELEGRAM_CHAT_ID = "your-telegram-chat-id"

# Twilio WhatsApp Notification Settings (Optional / Template)
TWILIO_ACCOUNT_SID = "your-twilio-account-sid"
TWILIO_AUTH_TOKEN = "your-twilio-auth-token"
TWILIO_WHATSAPP_FROM = "whatsapp:+14155238886"
TWILIO_CONTENT_SID = ""
